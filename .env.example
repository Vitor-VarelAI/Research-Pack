FIRECRAWL_API_KEY=fc-your-key-here
# Required by the production editorial runner; no defaults are used:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# Cockpit actions stay disabled unless explicitly set to 1. Mutations also require this exact origin.
SCRAPE_AGENT_COCKPIT_ACTIONS=0
# SCRAPE_AGENT_COCKPIT_ORIGIN=http://127.0.0.1:4173
# Optional:
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# SCRAPE_AGENT_DATA_DIR=data
# The cockpit reads an existing data directory and never writes to it.
# SCRAPE_AGENT_HOST=127.0.0.1
# SCRAPE_AGENT_PORT=4173
# Explicitly required before binding a non-loopback host:
# SCRAPE_AGENT_ALLOW_UNSAFE_HOST=1
